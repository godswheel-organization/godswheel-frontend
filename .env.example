# Dev server port — read by scripts/run-with-port.mjs, not by `next` itself
PORT=3000

# API
NEXT_PUBLIC_API_BASE_URL=http://localhost:8081/v1
# The site's own address (the real domain in production; keep the port in sync with PORT in dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session cookie name — read directly by src/proxy.ts via src/lib/env.ts
NEXT_PUBLIC_SESSION_COOKIE_NAME=session

# PWA is always on in production; this only matters in dev — use `npm run dev:pwa` instead of setting it here
NEXT_PUBLIC_ENABLE_PWA=false

# Dummy data until the backend is ready: API calls are answered in the browser, data kept in IndexedDB.
# Demo account: ada.okafor@example.com / password123. Set to false to call NEXT_PUBLIC_API_BASE_URL.
NEXT_PUBLIC_USE_MOCK_API=true

# Same-origin proxy (deploys where the frontend and backend are on different hosts; cookies are host-only).
# Set NEXT_PUBLIC_API_BASE_URL to <this app's origin>/v1, then:
# API_PROXY_TARGET=https://api.example.com
