# Dev server port — read by scripts/run-with-port.mjs, not by `next` itself
PORT=3000

# The GodsWheel API. The browser doesn't call it directly: it calls this app's own /api/v1 (the same path), which
# next.config.ts forwards here, so every call is same-origin (no CORS).
NEXT_PUBLIC_API_BASE_URL=https://godswheel.gigalixirapp.com/api/v1
# The site's own address (the real domain in production; keep the port in sync with PORT in dev).
# Canonical links, the sitemap and link-preview images are built from it. On Vercel it can be left unset:
# the production domain is used automatically (see src/lib/seo/site.ts). Set it once there's a custom domain.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session cookie name — read directly by src/proxy.ts via src/lib/env.ts
NEXT_PUBLIC_SESSION_COOKIE_NAME=session

# PWA is always on in production; this only matters in dev — use `npm run dev:pwa` instead of setting it here
NEXT_PUBLIC_ENABLE_PWA=false

# Dummy data for what isn't wired to the API yet (library, notes, history, settings), kept in IndexedDB.
# Sign-up, sign-in, the session and sign-out always use the real API (LIVE_ENDPOINTS in src/lib/api/baseQuery.ts).
# Set to false once every endpoint is integrated.
NEXT_PUBLIC_USE_MOCK_API=true
